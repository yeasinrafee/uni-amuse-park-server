datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model User {
  userId         String          @id @default(uuid())
  role           Role
  email          String          @unique
  name           String
  phone          String
  verified       Boolean         @default(false)
  password       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ticketBookings TicketBooking[]
  roomBookings   RoomBooking[]
}

enum PaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  ROCKET
  UPAY
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DUE
  PAID
}

enum DiscountType {
  NONE
  FLAT_DISCOUNT
  PERCENTAGE_DISCOUNT
}

enum IdentificationType {
  NID
  PASSPORT
  BCN
  DRIVING_LICENCE
}

enum Role {
  ADMIN
  CUSTOMER
}

model Room {
  id                 String              @id @default(uuid())
  roomNumber         String
  isUnderMaintenance Boolean             @default(false)
  price              Float
  roomTypeId         String
  roomType           RoomType            @relation(fields: [roomTypeId], references: [id])
  bookings           RoomBooking[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
}

model RoomType {
  id          String    @id @default(uuid())
  name        String
  description String?
  rooms       Room[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

enum RoomBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model RoomBooking {
  id                           String              @id @default(uuid())
  customerName                 String
  customerPhone                String
  customerEmail                String?
  customerIdentificationType   IdentificationType
  customerIdentificationNumber String

  // User linking for user-end bookings
  userId                       String?
  user                         User?               @relation(fields: [userId], references: [userId])

  // Payment fields
  paymentMethod                PaymentMethod?
  totalAmount                  Float
  paidAmount                   Float               @default(0)
  paymentStatus                PaymentStatus       @default(UNPAID)

  // Booking details
  roomId                       String
  room                         Room                @relation(fields: [roomId], references: [id])
  checkinDate                  DateTime
  checkoutDate                 DateTime
  
  status                       RoomBookingStatus   @default(PENDING)

  unifiedBookingId             String?
  unifiedBooking               UnifiedBooking?     @relation(fields: [unifiedBookingId], references: [id])

  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  @@index([roomId, checkinDate, checkoutDate], name: "room_booking_roomid_checkin_checkout_idx")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  items     Item[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Item {
  id          String                   @id @default(uuid())
  name        String
  price       Float
  description String?
  image       String?
  categories  Category[]
  orderItems  RestaurantOrderDetails[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?
}

model RestaurantOrder {
  id               String                   @id @default(uuid())
  discountAmount   Float?
  discountType     DiscountType
  customerName     String?
  customerPhone    String?
  paymentStatus    PaymentStatus            @default(UNPAID)
  status           RestaurantOrderStatus    @default(PENDING)
  baseAmount       Float
  totalAmount      Float
  paidAmount       Float                    @default(0)
  staffId          String
  orderItems       RestaurantOrderDetails[]
  
  unifiedBookingId String?
  unifiedBooking   UnifiedBooking?          @relation(fields: [unifiedBookingId], references: [id])

  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

enum RestaurantOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model RestaurantOrderDetails {
  id                String          @id @default(uuid())
  restaurantOrderId String
  itemId            String
  quantity          Int
  itemPrice         Float
  itemName          String
  discountAmount    Float?
  discountType      DiscountType
  subTotal          Float           @default(0)
  total             Float           @default(0)
  item              Item            @relation(fields: [itemId], references: [id])
  order             RestaurantOrder @relation(fields: [restaurantOrderId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum TicketBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model TicketBooking {
  id               String                @id @default(uuid())
  totalAmount      Float
  customerName     String?
  customerPhone    String?
  staffId          String
  userId           String?
  user             User?                 @relation(fields: [userId], references: [userId])
  status           TicketBookingStatus   @default(PENDING)
  bookingDetails   TicketBookingDetail[]

  unifiedBookingId String?
  unifiedBooking   UnifiedBooking?       @relation(fields: [unifiedBookingId], references: [id])

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model UnifiedBooking {
  id               String               @id @default(uuid())
  totalAmount      Float
  paidAmount       Float                @default(0)
  paymentStatus    PaymentStatus        @default(UNPAID)
  status           UnifiedBookingStatus @default(PENDING)
  paymentMethod    PaymentMethod?
  customerName     String?
  customerPhone    String?
  userId           String?
  staffId          String
  transactionId    String?              @unique

  // Refund tracking fields
  refundedAmount   Float                @default(0)
  refundStatus     RefundStatus?        // null = no refund yet

  ticketBookings   TicketBooking[]
  restaurantOrders RestaurantOrder[]
  roomBookings     RoomBooking[]
  refunds          Refund[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

enum UnifiedBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model TicketBookingDetail {
  id              String        @id @default(uuid())
  ticketBookingId String
  ticketTypeId    String
  quantity        Int
  price           Float
  ticketBooking   TicketBooking @relation(fields: [ticketBookingId], references: [id])
  ticketType      TicketType    @relation(fields: [ticketTypeId], references: [id])
}

model TicketType {
  id             String   @id @default(uuid())
  name           String
  image          String?
  price          Float
  bookingDetails TicketBookingDetail[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
}

model Refund {
  id                    String            @id @default(uuid())
  unifiedBookingId      String
  unifiedBooking        UnifiedBooking    @relation(fields: [unifiedBookingId], references: [id], onDelete: Cascade)
  
  // Refund details
  originalAmount        Float             // Original paid amount
  refundAmount          Float             // 80% of original amount
  refundPercentage      Float             @default(80) // Refund percentage (default 80%)
  paymentMethod         PaymentMethod     // Method used for refund (BKASH, BANK, NAGAD, ROCKET, UPAY)
  
  // Refund tracking
  status                RefundStatus      @default(PENDING)
  refundTransactionId   String?           @unique // Transaction ID from payment gateway
  notes                 String?           // Additional notes (error messages, etc.)
  
  // Metadata
  processedAt           DateTime?         // When refund was processed
  completedAt           DateTime?         // When refund was completed
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  @@index([unifiedBookingId])
  @@index([status])
  @@index([createdAt])
}

